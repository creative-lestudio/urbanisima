# ============================================================
# Grupo Urbanísima – configuración de Apache (SiteGround)
# ============================================================
# 1) Fuerza HTTPS y dominio sin "www"
# 2) Redirecciones 301 de las URLs antiguas de WordPress (conservan el posicionamiento en Google
#    y evitan errores 404 en anuncios y enlaces externos)
# 3) Compresión y caché
# ============================================================
<IfModule mod_rewrite.c>
RewriteEngine On

# Solo en el dominio real (no en subdominios de prueba): quita "www" y fuerza HTTPS
RewriteCond %{HTTP_HOST} ^www\.grupo-urbanisima\.com$ [NC]
RewriteRule ^ https://grupo-urbanisima.com%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^grupo-urbanisima\.com$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://grupo-urbanisima.com%{REQUEST_URI} [L,R=301]

# --- URLs antiguas -> web nueva. QSA conserva los parámetros originales (gclid, utm_*): imprescindible para no perder la atribución de Google Ads.
#     ?perfil y ?servicio preseleccionan el contenido; ?ir hace scroll a la sección.
RewriteRule ^contactar/?$ /?ir=contacto [R=301,L,QSA]
RewriteRule ^deshollinacion-de-chimeneas-en-alicante/?$ /?servicio=chimeneas&ir=servicios [R=301,L,QSA]
RewriteRule ^deshollinacion-de-chimeneas-en-castellon/?$ /?servicio=chimeneas&ir=servicios [R=301,L,QSA]
RewriteRule ^diseno-de-jardines-valencia/?$ /?servicio=jardines&ir=servicios [R=301,L,QSA]
RewriteRule ^especialistas-en-deshollinar-chimeneas/?$ /?servicio=chimeneas&ir=servicios [R=301,L,QSA]
RewriteRule ^especialistas-en-impermeabilizacion-en-valencia/?$ /?servicio=impermeabilizacion&ir=servicios [R=301,L,QSA]
RewriteRule ^impermeabilizacion-de-cubiertas-en-valencia/?$ /?servicio=impermeabilizacion&ir=servicios [R=301,L,QSA]
RewriteRule ^impermeabilizacion-de-cubiertas-valencia/?$ /?servicio=impermeabilizacion&ir=servicios [R=301,L,QSA]
RewriteRule ^impermeabilizacion-de-tejados-en-valencia/?$ /?servicio=impermeabilizacion&ir=servicios [R=301,L,QSA]
RewriteRule ^impermeabilizacion-de-terrazas-en-valencia/?$ /?servicio=impermeabilizacion&ir=servicios [R=301,L,QSA]
RewriteRule ^impermeabilizacion-y-reparacion-de-canalones/?$ /?servicio=canalones&ir=servicios [R=301,L,QSA]
RewriteRule ^instalacion-y-montaje-de-canalones-en-valencia/?$ /?servicio=canalones&ir=servicios [R=301,L,QSA]
RewriteRule ^instalacion-y-montaje-de-panel-sandwich/?$ /?servicio=panel&ir=servicios [R=301,L,QSA]
RewriteRule ^limpieza-y-deshollinado-de-chimenea-en-alicante/?$ /?servicio=chimeneas&ir=servicios [R=301,L,QSA]
RewriteRule ^limpieza-y-deshollinado-de-chimenea-en-castellon/?$ /?servicio=chimeneas&ir=servicios [R=301,L,QSA]
RewriteRule ^limpieza-y-deshollinado-de-chimenea-en-valencia/?$ /?servicio=chimeneas&ir=servicios [R=301,L,QSA]
RewriteRule ^limpieza-y-mantenimiento-de-canalones/?$ /?servicio=canalones&ir=servicios [R=301,L,QSA]
RewriteRule ^recarga-de-aires-acondicionados-en-valencia/?$ / [R=301,L,QSA]
RewriteRule ^reformas-integrales-de-locales-valencia/?$ /?perfil=empresas&servicio=locales&ir=servicios [R=301,L,QSA]
RewriteRule ^rehabilitacion-de-tejados-en-valencia/?$ /?servicio=tejados&ir=servicios [R=301,L,QSA]
RewriteRule ^rehabilitacion-de-terrazas-en-valencia/?$ /?servicio=impermeabilizacion&ir=servicios [R=301,L,QSA]
RewriteRule ^reparacion-cubiertas-naves-industriales-valencia/?$ /?perfil=empresas&servicio=tejados&ir=servicios [R=301,L,QSA]
RewriteRule ^reparacion-de-aire-acondicionado-en-valencia/?$ / [R=301,L,QSA]
RewriteRule ^reparacion-de-tejados-en-valencia/?$ /?servicio=tejados&ir=servicios [R=301,L,QSA]
RewriteRule ^reparacion-y-rehabilitacion-de-cubiertas-en-valencia/?$ /?servicio=tejados&ir=servicios [R=301,L,QSA]
RewriteRule ^servicios-a-comunidades-de-vecinos/?$ /?perfil=comunidades&ir=servicios [R=301,L,QSA]
RewriteRule ^servicios-a-empresas-comercios-y-naves-industriales/?$ /?perfil=empresas&ir=servicios [R=301,L,QSA]
RewriteRule ^servicios-a-particulares/?$ /?perfil=particulares&ir=servicios [R=301,L,QSA]
RewriteRule ^servicios-de-montaje-e-instalacion-de-aire-acondicionado-en-valencia/?$ / [R=301,L,QSA]
RewriteRule ^servicios-grupo-urbanisima/?$ /?ir=servicios [R=301,L,QSA]
RewriteRule ^servicios-grupo-urbanisima/recarga-de-aires-acondicionados/?$ / [R=301,L,QSA]
RewriteRule ^servicios-grupo-urbanisima/servicio-de-limpieza-y-deshollinado-de-chimenea/?$ /?servicio=chimeneas&ir=servicios [R=301,L,QSA]
RewriteRule ^servicios-grupo-urbanisima/servicio-de-pintura-epoxi-en-pavimento-continuo/?$ /?servicio=epoxi&ir=servicios [R=301,L,QSA]
RewriteRule ^servicios-grupo-urbanisima/servicios-de-impermeabilizacion-de-cubiertas/?$ /?servicio=impermeabilizacion&ir=servicios [R=301,L,QSA]
RewriteRule ^servicios-grupo-urbanisima/servicios-de-impermeabilizacion-de-terrazas/?$ /?servicio=impermeabilizacion&ir=servicios [R=301,L,QSA]
RewriteRule ^servicios-grupo-urbanisima/servicios-de-jardineria/?$ /?servicio=jardines&ir=servicios [R=301,L,QSA]
RewriteRule ^servicios-grupo-urbanisima/servicios-de-limpieza-de-canalones/?$ /?servicio=canalones&ir=servicios [R=301,L,QSA]
RewriteRule ^servicios-grupo-urbanisima/servicios-de-montaje-de-panel-sandwich/?$ /?servicio=panel&ir=servicios [R=301,L,QSA]
RewriteRule ^servicios-grupo-urbanisima/servicios-de-pintores-de-casas-y-chalets-particulares-en-valencia/?$ /?servicio=fachadas&ir=servicios [R=301,L,QSA]
RewriteRule ^servicios-grupo-urbanisima/servicios-de-pintores-de-fachadas-y-patios-interiores/?$ /?servicio=fachadas&ir=servicios [R=301,L,QSA]
RewriteRule ^servicios-grupo-urbanisima/servicios-de-reformas/?$ /?servicio=reformas&ir=servicios [R=301,L,QSA]
RewriteRule ^servicios-grupo-urbanisima/servicios-de-rehabilitacion-y-limpieza-de-piscinas-en-valencia/?$ /?servicio=piscinas&ir=servicios [R=301,L,QSA]
RewriteRule ^servicios-grupo-urbanisima/servicios-de-reparacion-de-tejados/?$ /?servicio=tejados&ir=servicios [R=301,L,QSA]

# --- Archivos antiguos de WordPress que ya no existen
RewriteRule ^(wp-login\.php|xmlrpc\.php)$ - [R=404,L]
RewriteRule ^(wp-admin|wp-content|wp-includes|wp-json)(/|$) - [R=410,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType image/png "access plus 6 months"
ExpiresByType image/jpeg "access plus 6 months"
ExpiresByType text/css "access plus 1 week"
ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Páginas sin extensión y errores
DirectoryIndex index.html
Options -Indexes
